# Path to the TOML config listing log sources. Defaults to config.toml in the working directory.
HITATLAS_CONFIG=config.toml

# Path to the MaxMind GeoLite2 City database. Defaults to GeoLite2-City.mmdb in the working directory.
HITATLAS_GEOIP_DB=GeoLite2-City.mmdb

# Port for the internal SSE server (always binds to 127.0.0.1, put Nginx in front of it).
HITATLAS_HTTP_PORT=8765

# Python logging level (e.g. DEBUG to see raw unmatched log lines).
HITATLAS_LOG_LEVEL=INFO

# Seconds between re-scans of path_glob sources for newly added sites.
HITATLAS_RESCAN_INTERVAL=30
